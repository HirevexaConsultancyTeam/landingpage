generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  mobile           String?          @unique
  password         String
  role             Role             @default(CANDIDATE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  registrationPaid Boolean          @default(false)
  candidate        Candidate?
  enrollments      Enrollment[]
  orders           Order[]
  reviews          Review[]
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  certificates     Certificate[]
  moduleProgress   ModuleProgress[]  // NEW
  exerciseAttempts ExerciseAttempt[] // NEW
}

model Candidate {
  id           String          @id @default(cuid())
  userId       String          @unique
  firstName    String
  lastName     String
  city         String?
  degree       String?
  branch       String?
  college      String?
  gradYear     String?
  cgpa         String?
  experience   String          @default("fresher")
  jobType      String?
  locations    String[]
  salary       String?
  skills       String[]
  profileScore Int             @default(0)
  status       CandidateStatus @default(ONBOARDING)
  counsellorId String?
  resumeUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  applications Application[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
}

model Job {
  id           String           @id @default(cuid())
  company      String
  role         String
  location     String?
  jobType      JobType?
  experience   ExperienceLevel?
  salary       String?
  openings     Int              @default(1)
  skills       String[]
  description  String?
  deadline     DateTime?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  applications Application[]
}

model Application {
  id              String    @id @default(cuid())
  candidateId     String
  jobId           String
  status          AppStatus @default(APPLIED)
  appliedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  interviewDate   DateTime?
  notes           String?
  offerSalary     String?
  rejectionReason String?
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
}

model Document {
  id          String    @id @default(cuid())
  candidateId String
  name        String
  type        String
  url         String
  status      DocStatus @default(UPLOADED)
  uploadedAt  DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  courses   Course[]
}

model Course {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String
  description      String
  thumbnail        String?
  previewVideo     String?
  language         String
  duration         String?
  level            CourseLevel
  price            Float
  discount         Float          @default(0)
  featured         Boolean        @default(false)
  published        Boolean        @default(false)
  instructor       String?
  categoryId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  thumbnailUrl     String?
  previewVideoUrl  String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  modules          CourseModule[]
  enrollments      Enrollment[]
  orders           Order[]
  reviews          Review[]
  certificates     Certificate[]
}

model CourseModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  courseId    String

  // NEW — structural fields the demo relies on
  slug        String?  // stable URL segment, e.g. "core-language"
  summary     String?  // 1–3 sentence blurb shown on the module card
  icon        String?  // lucide icon name, e.g. "target" / "award"
  isFinalExam Boolean  @default(false) // only unlocks once every other module is COMPLETED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quiz        Quiz?
  progress    ModuleProgress[] // NEW

  @@unique([courseId, slug])
  @@index([courseId])
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  content     String? @db.Text // LEGACY — free-text fallback, kept so existing rows aren't lost
  videoUrl    String?
  notesUrl    String?
  duration    String? // LEGACY — "mm:ss" string; prefer durationMinutes below
  isPreview   Boolean @default(false)
  order       Int
  moduleId    String

  // NEW — structured lesson body
  slug               String?
  durationMinutes    Int?
  learningObjectives String[] // bullet list shown at the top of the lesson
  theory             String?  @db.Text // long-form markdown body
  codeExamples       Json?    // [{ title, language, code, output, notes }]
  visualExamples     Json?    // [{ caption, diagramSvg }]
  interviewTips      String[]
  commonMistakes     String[]
  bestPractices      String[]
  realWorldExample   String?  @db.Text
  summary            String?  @db.Text // "key takeaways" block at the end

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  resources CourseResource[]
  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  exercises Exercise[] // NEW

  @@unique([moduleId, slug])
  @@index([moduleId])
}

// NEW — per-lesson drills (MCQ, output prediction, etc.)
model Exercise {
  id          String       @id @default(cuid())
  lessonId    String
  order       Int
  type        ExerciseType @default(MCQ)
  prompt      String       @db.Text
  payload     Json // MCQ: { options: string[], correctIndex: number }
  // OUTPUT_PREDICTION: { options: string[], correctIndex: number }
  // SHORT_ANSWER:      { acceptable: string[] }
  hint        String?      @db.Text
  solution    String?      @db.Text // the bare answer
  explanation String?      @db.Text // why that answer is right
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    ExerciseAttempt[]

  @@index([lessonId])
}

// NEW
model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  response   Json // whatever the student submitted
  isCorrect  Boolean
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// NEW — drives the locked / unlocked UI
model ModuleProgress {
  id            String       @id @default(cuid())
  userId        String
  moduleId      String
  status        ModuleStatus @default(LOCKED)
  bestQuizScore Int          @default(0)
  unlockedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
}

model Quiz {
  id        String         @id @default(cuid())
  moduleId  String         @unique
  title     String
  passScore Int            @default(70) // single source of truth for the pass threshold
  module    CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       String[]
  correctOption Int
  order         Int
  explanation   String?  @db.Text // NEW — shown in answer review
  topic         String?  // NEW — feeds the "topics to revise" list
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  quizId        String
  score         Int
  passed        Boolean
  attemptNumber Int      @default(1) // NEW
  startedAt     DateTime? // NEW — set when the quiz is opened
  answers       Json? // NEW — [{ questionId, selected, correct, isCorrect }] for review
  weakTopics    String[] // NEW — distinct topics of wrong answers
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  code       String   @unique
  finalScore Int
  issuedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  courseId        String?
  type            OrderType   @default(COURSE)
  amount          Float
  status          OrderStatus @default(CREATED)
  razorpayOrderId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  course          Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment         Payment?

  @@index([userId])
  @@index([courseId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model CourseResource {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String
  lessonId  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// Leftover from the Neon starter template — safe to delete if nothing references it.
model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum Role {
  CANDIDATE
  ADMIN
  COUNSELLOR
}

enum CandidateStatus {
  ONBOARDING
  RESUME_REVIEW
  INTERVIEW_STAGE
  OFFER_RECEIVED
  PLACED
}

enum AppStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  OFFER_RECEIVED
  REJECTED
  PLACED
}

enum DocStatus {
  UPLOADED
  APPROVED
  REJECTED
  PENDING
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  PART_TIME
  CONTRACT
  FREELANCE
}

enum ExperienceLevel {
  FRESHER
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_PLUS
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// NEW
enum ModuleStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

// NEW
enum ExerciseType {
  MCQ
  OUTPUT_PREDICTION
  SHORT_ANSWER
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderType {
  COURSE
  REGISTRATION
}
